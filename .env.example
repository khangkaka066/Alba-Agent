# Copy to .env and set unique secrets before starting the stack.
NEXUS_BRAND_NAME=NexusAgent Studio
NEXUS_DOMAIN=studio.example.com
NEXUS_POSTGRES_USER=nexus
NEXUS_POSTGRES_DB=nexus
NEXUS_POSTGRES_PASSWORD=
NEXUS_RUNTIME_DB_PASSWORD=
NEXUS_REDIS_PASSWORD=
NEXUS_SECRET_KEY=
NEXUS_API_KEY_PEPPER=
NEXUS_CREDENTIAL_ENCRYPTION_KEY_BASE64=
# Optional alias accepted by the credential vault; provide the same 32-byte AES key encoded as base64.
NEXUS_ENCRYPTION_KEY=
# Optional. Leave empty: models without a price (and every subscription plan) run at $0 as SUBSCRIPTION_INCLUDED.
# Set per-token prices only if you want estimated spend for API-key models, e.g. {"openai/gpt-4.1-mini":{"prompt_usd_per_million":"0.4","completion_usd_per_million":"1.6"}}
NEXUS_MODEL_RATES_JSON={}
# Optional: mount a CLI login folder read-only so Settings can detect your subscription (default: ./data/subscriptions/<name>).
# NEXUS_CODEX_HOME=/Users/you/.codex
# NEXUS_CLAUDE_HOME=/Users/you/.claude
# NEXUS_GEMINI_HOME=/Users/you/.gemini
# NEXUS_COPILOT_HOME=/Users/you/.config/github-copilot
# Set to false on any shared server: the mounted logins belong to the operator, not to tenants.
# NEXUS_MOUNTED_SUBSCRIPTIONS_ENABLED=true
# Local single-user mode opens the app without sign-in (the compose file turns it on and binds ports to 127.0.0.1).
# Set NEXUS_LOCAL_MODE=false on any shared or public server.
# NEXUS_LOCAL_MODE=true
# Set to false to run the API without --reload.
# NEXUS_RELOAD=true
NEXUS_OUTPUT_SCHEMAS_JSON={}
NEXUS_AUTOGEN_API_KEY=
NEXUS_AUTOGEN_API_BASE=
NEXUS_OPENAI_API_KEY=
NEXUS_SERPER_API_KEY=
NEXUS_TAVILY_API_KEY=
NEXUS_OPENAI_API_BASE=https://api.openai.com/v1
NEXUS_ANTHROPIC_API_KEY=
NEXUS_ANTHROPIC_API_BASE=https://api.anthropic.com
NEXUS_GEMINI_API_KEY=
NEXUS_GEMINI_API_BASE=https://generativelanguage.googleapis.com
NEXUS_DEEPSEEK_API_KEY=
NEXUS_DEEPSEEK_API_BASE=https://api.deepseek.com/v1
NEXUS_OPENROUTER_API_KEY=
NEXUS_OPENROUTER_API_BASE=https://openrouter.ai/api/v1
NEXUS_GROQ_API_KEY=
NEXUS_GROQ_API_BASE=https://api.groq.com/openai/v1
NEXUS_MISTRAL_API_KEY=
NEXUS_MISTRAL_API_BASE=https://api.mistral.ai/v1
NEXUS_TOGETHER_AI_API_KEY=
NEXUS_TOGETHER_AI_API_BASE=https://api.together.xyz/v1
NEXUS_ALLOWED_LOCAL_MODEL_BASES_JSON=[]
NEXUS_STT_API_KEY=
NEXUS_STT_API_BASE=https://api.openai.com/v1
NEXUS_STT_MODEL=whisper-1
NEXUS_TTS_API_KEY=
NEXUS_TTS_API_BASE=https://api.openai.com/v1
NEXUS_TTS_MODEL=tts-1
NEXUS_TTS_VOICE=alloy
NEXUS_COMPUTER_ROOT=/tmp/nexus-computers
NEXUS_SANDBOX_IMAGE=nexus-sandbox-python:3.11
NEXUS_DOCKER_GID=0
# Optional: only needed when public signup is disabled for a private installation.
NEXUS_REGISTRATION_TOKEN=
NEXUS_PUBLIC_SIGNUP_ENABLED=true
NEXUS_NEW_TENANT_CREDIT_USD=10
# Optional JSON overrides for FREE/PRO/ENTERPRISE limits.
NEXUS_BILLING_PLAN_LIMITS_JSON=
NEXUS_BILLING_PRODUCT_PLANS_JSON={}
NEXUS_BILLING_PRODUCT_CREDITS_JSON={}
# Offline Enterprise license JWT and the Ed25519 public key used to verify it.
NEXUS_LICENSE_KEY=
NEXUS_LICENSE_PUBLIC_KEY=
# Configure only the webhook providers enabled for this deployment.
NEXUS_STRIPE_WEBHOOK_SECRET=
NEXUS_POLAR_WEBHOOK_SECRET=
NEXUS_VIETQR_WEBHOOK_SECRET=
NEXUS_BACKUP_RETENTION_DAYS=14
NEXUS_BACKUP_INTERVAL_SECONDS=86400
NEXUS_WORKER_LOG_LEVEL=INFO
NEXUS_WORKER_CONCURRENCY=2
# Frontier models eligible for golden-trace capture; shadow candidates are evaluated after 20 approved traces.
NEXUS_GOLDEN_TRACE_MODELS=openai/gpt-4.1,anthropic/claude-sonnet-4,gemini/gemini-2.5-pro
NEXUS_DISTILLATION_CANDIDATES=openai/gpt-4o-mini,gemini/gemini-2.5-flash,deepseek/deepseek-chat
NEXUS_API_PORT=8000
NEXUS_WEB_PORT=3000
NEXUS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
