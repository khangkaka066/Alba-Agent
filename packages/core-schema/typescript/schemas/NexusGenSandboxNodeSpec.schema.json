{
  "$defs": {
    "ConsensusConfigSpec": {
      "additionalProperties": false,
      "properties": {
        "arbiter_model": {
          "default": "",
          "title": "Arbiter Model",
          "type": "string"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "min_agreement_threshold": {
          "default": 0.85,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Min Agreement Threshold",
          "type": "number"
        },
        "models": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 0,
          "title": "Models",
          "type": "array"
        }
      },
      "title": "ConsensusConfigSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "coder_instructions": {
      "default": "",
      "title": "Coder Instructions",
      "type": "string"
    },
    "coder_model": {
      "minLength": 1,
      "title": "Coder Model",
      "type": "string"
    },
    "computer_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Computer Id"
    },
    "consensus_config": {
      "$ref": "#/$defs/ConsensusConfigSpec"
    },
    "expected_artifact_paths": {
      "default": [],
      "items": {
        "maxLength": 240,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,79}(/[A-Za-z0-9_][A-Za-z0-9_.-]{0,79}){0,7}$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Expected Artifact Paths",
      "type": "array"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "join": {
      "default": "any",
      "enum": [
        "any",
        "all"
      ],
      "title": "Join",
      "type": "string"
    },
    "kind": {
      "const": "sandbox",
      "default": "sandbox",
      "title": "Kind",
      "type": "string"
    },
    "label": {
      "minLength": 1,
      "title": "Label",
      "type": "string"
    },
    "max_rounds": {
      "default": 8,
      "maximum": 50,
      "minimum": 1,
      "title": "Max Rounds",
      "type": "integer"
    },
    "on_failure": {
      "default": "fail",
      "enum": [
        "fail",
        "continue"
      ],
      "title": "On Failure",
      "type": "string"
    },
    "on_unverified": {
      "default": "deliver_labeled",
      "enum": [
        "deliver_labeled",
        "fail"
      ],
      "title": "On Unverified",
      "type": "string"
    },
    "requires_visual_evidence": {
      "default": false,
      "title": "Requires Visual Evidence",
      "type": "boolean"
    },
    "reviewer_instructions": {
      "default": "",
      "title": "Reviewer Instructions",
      "type": "string"
    },
    "reviewer_model": {
      "minLength": 1,
      "title": "Reviewer Model",
      "type": "string"
    },
    "sandbox_provider": {
      "default": "docker",
      "enum": [
        "docker",
        "e2b",
        "daytona"
      ],
      "title": "Sandbox Provider",
      "type": "string"
    },
    "skill_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Skill Ids",
      "type": "array"
    },
    "timeout_seconds": {
      "default": 300,
      "maximum": 3600,
      "minimum": 1,
      "title": "Timeout Seconds",
      "type": "integer"
    },
    "tool_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Tool Ids",
      "type": "array"
    },
    "verification_command": {
      "minLength": 1,
      "title": "Verification Command",
      "type": "string"
    }
  },
  "required": [
    "id",
    "label",
    "coder_model",
    "reviewer_model",
    "verification_command"
  ],
  "title": "NexusGenSandboxNodeSpec",
  "type": "object"
}
